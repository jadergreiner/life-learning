FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir pytest

COPY src ./src
COPY tests ./tests
COPY pytest.ini ./pytest.ini

CMD ["pytest", "-q", "tests"]
